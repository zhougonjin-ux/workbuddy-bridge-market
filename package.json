{
  "name": "workbuddy-bridge-market",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm --prefix workbuddy-bridge/server test",
    "smoke": "npm --prefix workbuddy-bridge/server run smoke",
    "build:market": "node scripts/build-market.mjs",
    "check:market": "node scripts/build-market.mjs --check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "e2e": "node scripts/e2e-smoke.mjs",
    "lint": "node scripts/lint.mjs",
    "coverage": "node scripts/coverage.mjs",
    "verify": "npm run lint && npm run check:routes && npm run test && npm run check:market && npm run check:docs",
    "sync:install": "node scripts/sync-install.mjs"
  }
}